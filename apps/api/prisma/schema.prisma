/// Formal meeting minutes (صورتجلسات) and decisions (Audit CRIT-01)
/// Source: Product Document p. 20 §22
model Meeting {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  campaignId       String?  @db.Uuid
  title            String   @db.VarChar(255)
  meetingDate      DateTime
  location         String?  @db.VarChar(255)
  attendeesSummary String?  @db.VarChar(500)
  summary          String?  @db.Text
  notes            String?  @db.Text
  versionNumber    Int      @default(1) // شماره نسخه برای ویرایش پس از ارسال (p. 20)
  createdById      String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?           @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  actionItems  MeetingActionItem[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([campaignId])
  @@map("meetings")
}

/// Decision converted to an actionable task from meeting minutes (Audit CRIT-01)
/// Source: Product Document p. 20 §22
model MeetingActionItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  meetingId      String    @db.Uuid
  taskId         String?   @db.Uuid
  description    String    @db.Text
  assigneeId     String?   @db.Uuid
  dueDate        DateTime? @db.Date
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee     User?        @relation("MeetingActionItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([meetingId])
  @@index([taskId])
  @@map("meeting_action_items")
}

/// Standard operating procedure document (Audit CRIT-01)
/// Source: Product Document p. 20 §23, p. 21 §23
model Sop {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  title          String    @db.VarChar(255)
  code           String    @db.VarChar(100)
  category       String    @db.VarChar(100) // Configurable taxonomy
  currentVersion String    @default("1.0") @db.VarChar(20)
  status         SopStatus @default(draft)
  authorId       String    @db.Uuid
  approverId     String?   @db.Uuid
  content        String    @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author        User         @relation("SopAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approver      User?        @relation("SopApprover", fields: [approverId], references: [id], onDelete: SetNull)
  versions      SopVersion[]
  tasksUsingSop Task[]       @relation("TaskSopSource")

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("sops")
}

/// Historical version archive for standard operating procedures (Audit CRIT-01)
/// Source: Product Document p. 20 §23, p. 21 §23
model SopVersion {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sopId          String   @db.Uuid
  versionNumber  String   @db.VarChar(20)
  changeSummary  String?  @db.VarChar(500)
  content        String   @db.Text
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sop          Sop          @relation(fields: [sopId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User         @relation("SopVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sopId, versionNumber])
  @@index([organizationId])
  @@index([sopId])
  @@map("sop_versions")
}

/// Training resources and professional development content (Audit CRIT-01)
/// Source: Product Document p. 21 §24
model LearningResource {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  title           String   @db.VarChar(255)
  category        String   @db.VarChar(100)
  software        String?  @db.VarChar(100) // فیلتر نرم‌افزار (p. 21)
  type            String   @db.VarChar(50) // video, article, book, link
  url             String?  @db.VarChar(1000)
  durationMinutes Int?
  description     String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProgress UserLearningProgress[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([organizationId, category])
  @@map("learning_resources")
}

/// User completion and rating for training materials (Audit CRIT-01)
/// Source: Product Document p. 21 §24 (جدول کاربر × آموزش با وضعیت)
model UserLearningProgress {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  resourceId     String    @db.Uuid
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  rating         Int?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     LearningResource @relation(fields: [resourceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_learning_progress")
}

/// Creative marketing brainstorming proposal and voting item (Audit CRIT-01, MAJ-05)
/// Source: Product Document p. 21 §25, p. 22 §25
model Idea {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  campaignId     String?    @db.Uuid
  taskId         String?    @db.Uuid // لینک تسک ساخته‌شده (Audit MAJ-05, p. 22)
  title          String     @db.VarChar(255)
  description    String     @db.Text
  category       String     @db.VarChar(100)
  status         IdeaStatus @default(submitted)
  outcomeNotes   String?    @db.Text // ثبت نتیجه ایده اجراشده (Audit MAJ-05, p. 22)
  authorId       String     @db.Uuid
  votesCount     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task         Task?        @relation("IdeaCreatedTask", fields: [taskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  author       User         @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  votes        IdeaVote[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([taskId])
  @@map("ideas")
}

/// User vote on creative proposals (Audit CRIT-01)
/// Source: Product Document p. 22 §25
model IdeaVote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  ideaId         String   @db.Uuid
  userId         String   @db.Uuid
  voteType       VoteType @default(upvote)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  idea         Idea         @relation(fields: [ideaId, organizationId], references: [id, organizationId], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([organizationId])
  @@index([ideaId])
  @@map("idea_votes")
}

