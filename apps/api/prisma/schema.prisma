datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ==============================================================================
// ENUMS
// ==============================================================================

/// Approved technical roles for user memberships within organizations (6 approved roles)
/// Source: docs/PROJECT-DECISIONS.md §3, Product Document p. 23 §27
enum Role {
  admin             @map("admin") // مدیر ارشد سازمان / سیستم
  marketing_manager @map("marketing_manager") // مدیر مارکتینگ
  campaign_manager  @map("campaign_manager") // کمپین‌چی
  sales_agent       @map("sales_agent") // کارشناس فروش
  content_creator   @map("content_creator") // تولید محتوا و وبینار
  client            @map("client") // کارفرما (فقط خواندنی)
}

enum TokenStatus {
  ACTIVE   @map("ACTIVE")
  CONSUMED @map("CONSUMED")
  REVOKED  @map("REVOKED")
  EXPIRED  @map("EXPIRED")
}

/// Approved organization monetary units
/// Source: docs/PROJECT-DECISIONS.md §3, Product Document p. 4 §1-2, p. 24 §28
enum Currency {
  TOMAN @map("toman") // تومان (Default)
  RIAL  @map("rial") // ریال
}

/// Organization membership status
/// Source: Product Document p. 23 §27
enum MembershipStatus {
  active   @map("active") // فعال
  invited  @map("invited") // دعوت‌شده
  inactive @map("inactive") // غیرفعال
}

/// Campaign lifecycle state
/// Source: Product Document p. 5 §3-2, p. 9 §6
enum CampaignStatus {
  draft     @map("draft") // پیش‌نویس
  planned   @map("planned") // برنامه‌ریزی‌شده
  active    @map("active") // فعال
  paused    @map("paused") // متوقف
  completed @map("completed") // تکمیل‌شده
  archived  @map("archived") // آرشیوشده
}

/// Campaign health indicator badge
/// Source: Product Document p. 5 §3-2, p. 8 §4, p. 9 §6
enum CampaignHealth {
  healthy         @map("healthy") // سالم (سبز)
  needs_attention @map("needs_attention") // نیازمند توجه (زرد)
  critical        @map("critical") // ضعیف / بحرانی (قرمز)
}

/// Lead status group for customizable pipeline stages (Audit MAJ-02)
/// Source: Product Document p. 23 §28 (ستون «گروه»: باز/برنده/بازنده)
enum LeadStatusGroup {
  open @map("open") // باز
  won  @map("won") // برنده (مشتری)
  lost @map("lost") // بازنده (ردشده)
}

/// Lead customer journey activity type
/// Source: Product Document p. 16 §16
enum LeadActivityType {
  ad_click      @map("ad_click") // کلیک روی تبلیغ
  landing_visit @map("landing_visit") // بازدید از لندینگ
  form_submit   @map("form_submit") // ثبت فرم
  call          @map("call") // تماس تلفنی
  note          @map("note") // یادداشت داخلی
  status_change @map("status_change") // تغییر وضعیت لید
  assignment    @map("assignment") // ارجاع به کارشناس
  purchase      @map("purchase") // خرید نهایی
  rejection     @map("rejection") // رد شدن لید
}

/// Telephony call log outcome
/// Source: Product Document p. 16 §17
enum LeadCallStatus {
  successful  @map("successful") // موفق
  no_answer   @map("no_answer") // عدم پاسخگویی
  busy        @map("busy") // اشغال
  rescheduled @map("rescheduled") // تعیین زمان مجدد
}

/// Task execution state
/// Source: Product Document p. 5 §3-2, p. 18 §19
enum TaskStatus {
  todo        @map("todo") // انجام نشده
  in_progress @map("in_progress") // در حال انجام
  waiting     @map("waiting") // در انتظار
  done        @map("done") // انجام شده
  overdue     @map("overdue") // به تعویق افتاده / منقضی
}

/// Task urgency priority
/// Source: Product Document p. 18 §19
enum TaskPriority {
  low    @map("low") // کم
  medium @map("medium") // متوسط
  high   @map("high") // بالا
  urgent @map("urgent") // اضطراری
}

/// Polymorphic target relation type for tasks
/// Source: Product Document p. 18 §19, p. 20 §22
enum TaskRelatedType {
  campaign  @map("campaign")
  webinar   @map("webinar")
  lead      @map("lead")
  sop       @map("sop")
  equipment @map("equipment")
  meeting   @map("meeting")
}

/// Source mechanism of financial cost entry
/// Source: Product Document p. 11 §9, p. 12 §9
enum CostSource {
  manual @map("manual") // ثبت دستی
  import @map("import") // ایمپورت از فایل
}

/// Platform data retrieval method (Audit MIN-01)
/// Source: Product Document p. 11 §8
enum PlatformRetrievalMethod {
  manual @map("manual") // دستی
  api    @map("api") // API
  import @map("import") // Import
}

/// Equipment readiness state for campaign/webinar gear (Audit CRIT-03)
/// Source: Product Document p. 5 §3-2, p. 19 §21
enum EquipmentReadinessStatus {
  ready        @map("ready") // آماده (سبز)
  incomplete   @map("incomplete") // ناقص (زرد)
  not_procured @map("not_procured") // تهیه نشده (قرمز)
}

/// Webinar lifecycle state
/// Source: Product Document p. 17 §18
enum WebinarStatus {
  draft     @map("draft") // پیش‌نویس
  scheduled @map("scheduled") // برنامه‌ریزی‌شده
  live      @map("live") // در حال برگزاری
  completed @map("completed") // به پایان رسیده / برگزارشده
  cancelled @map("cancelled") // لغو شده
}

/// SMS campaign delivery state
/// Source: Product Document p. 16 §16, p. 17 §17
enum SmsStatus {
  draft     @map("draft") // پیش‌نویس
  scheduled @map("scheduled") // زمان‌بندی‌شده
  sending   @map("sending") // در حال ارسال
  sent      @map("sent") // ارسال‌شده
  failed    @map("failed") // با خطا مواجه شده
}

/// Individual SMS recipient delivery status (Audit MAJ-01)
/// Source: Product Document p. 17 §17
enum SmsDeliveryStatus {
  pending   @map("pending") // در انتظار ارسال
  delivered @map("delivered") // تحویل داده شده
  failed    @map("failed") // ناموفق
}

/// Standard operating procedure workflow state
/// Source: Product Document p. 20 §23
enum SopStatus {
  draft    @map("draft") // پیش‌نویس
  active   @map("active") // معتبر / فعال
  archived @map("archived") // بایگانی‌شده
}

/// Creative idea evaluation stage
/// Source: Product Document p. 21 §25, p. 22 §25
enum IdeaStatus {
  submitted   @map("submitted") // ثبت‌شده
  reviewing   @map("reviewing") // در حال بررسی
  approved    @map("approved") // تاییدشده
  rejected    @map("rejected") // ردشده
  implemented @map("implemented") // اجراشده
}

/// User voting on ideas
/// Source: Product Document p. 22 §25
enum VoteType {
  upvote   @map("upvote") // موافق
  downvote @map("downvote") // مخالف
}

/// Metric optimization direction (Audit MAJ-04)
/// Source: Product Document p. 5 §3-2, p. 13 §11
enum MetricDirection {
  higher_is_better @map("higher_is_better") // بالاتر بهتر (پیش‌فرض)
  lower_is_better  @map("lower_is_better") // کمتر بهتر (CPL, CAC)
}

/// File import target entity type
/// Source: Product Document p. 12 §10, p. 13 §10
enum ImportDataType {
  leads    @map("leads")
  costs    @map("costs")
  contacts @map("contacts")
}

/// File import asynchronous execution state
/// Source: Product Document p. 12 §10
enum ImportStatus {
  pending    @map("pending")
  processing @map("processing")
  completed  @map("completed")
  failed     @map("failed")
}

/// System and user alert notification category
/// Source: Product Document p. 7 §3
enum NotificationType {
  info    @map("info")
  success @map("success")
  warning @map("warning")
  alert   @map("alert")
}

// ==============================================================================
// 1. IDENTITY & ACCESS MANAGEMENT (IAM) & TENANCY ROOT
// ==============================================================================

/// Global user identity across organizations
/// Source: Product Document p. 6 §1, p. 23 §27
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String?   @unique @db.VarChar(255)
  mobile       String?   @unique @db.VarChar(20)
  passwordHash String    @db.VarChar(255)
  fullName     String    @db.VarChar(255)
  avatarUrl    String?   @db.VarChar(500)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Tenant memberships
  memberships             OrganizationMembership[]
  sessions                Session[]
  refreshTokens           RefreshToken[]
  notificationPreferences NotificationPreference[]

  // Owned or created entities
  ownedCampaigns         Campaign[]             @relation("CampaignOwner")
  assignedLeads          Lead[]                 @relation("LeadAssignee")
  createdCosts           Cost[]                 @relation("CostCreator")
  createdTasks           Task[]                 @relation("TaskCreator")
  assignedTasks          Task[]                 @relation("TaskAssignee")
  taskComments           TaskComment[]
  leadActivities         LeadActivity[]         @relation("LeadActivityActor")
  leadCalls              LeadCall[]             @relation("LeadCallCaller")
  authoredSops           Sop[]                  @relation("SopAuthor")
  approvedSops           Sop[]                  @relation("SopApprover")
  sopVersions            SopVersion[]           @relation("SopVersionCreator")
  ideas                  Idea[]                 @relation("IdeaAuthor")
  ideaVotes              IdeaVote[]
  learningProgress       UserLearningProgress[]
  createdMeetings        Meeting[]              @relation("MeetingCreator")
  assignedActionItems    MeetingActionItem[]    @relation("MeetingActionItemAssignee")
  responsibleEquipments  EventEquipment[]       @relation("EquipmentResponsible")
  calendarEvents         CalendarEvent[]        @relation("CalendarEventCreator")
  assignedCalendarEvents CalendarEvent[]        @relation("CalendarEventAssignee")
  importJobs             ImportJob[]            @relation("ImportJobCreator")
  notifications          Notification[]
  activityLogs           UserActivityLog[]

  @@map("users")
}

/// Tenant isolation root representing an organization or business unit
/// Source: Product Document p. 6 §1, p. 24 §28; docs/PROJECT-DECISIONS.md §3
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  logoUrl   String?  @db.VarChar(500)
  currency  Currency @default(TOMAN)
  timezone  String   @default("Asia/Tehran") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-tenant relational scope
  memberships             OrganizationMembership[]
  sessions                Session[]
  taxonomies              OrganizationTaxonomy[]
  notificationPreferences NotificationPreference[]
  campaigns               Campaign[]
  platforms               Platform[]
  platformAllocations     CampaignPlatformAllocation[]
  targetAudiences         TargetAudience[]
  campaignAudiences       CampaignAudience[]
  landingPages            LandingPage[]
  utmLinks                UtmLink[]
  costs                   Cost[]
  costCategories          CostCategory[]
  leadStatusConfigs       LeadStatusConfig[]
  leads                   Lead[]
  leadActivities          LeadActivity[]
  leadCalls               LeadCall[]
  smsCampaigns            SmsCampaign[]
  smsRecipients           SmsRecipient[]
  webinars                Webinar[]
  webinarAttendees        WebinarAttendee[]
  tasks                   Task[]
  taskSubtasks            TaskSubtask[]
  taskComments            TaskComment[]
  calendarEvents          CalendarEvent[]
  equipmentItems          EquipmentItem[]
  equipmentTemplates      EquipmentTemplate[]
  equipmentTemplateItems  EquipmentTemplateItem[]
  eventEquipments         EventEquipment[]
  meetings                Meeting[]
  meetingActionItems      MeetingActionItem[]
  sops                    Sop[]
  sopVersions             SopVersion[]
  learningResources       LearningResource[]
  userLearningProgress    UserLearningProgress[]
  ideas                   Idea[]
  ideaVotes               IdeaVote[]
  kpiMetrics              KpiMetric[]
  customMetrics           CustomMetric[]
  kpiAlertRules           KpiAlertRule[]
  importJobs              ImportJob[]
  notifications           Notification[]
  activityLogs            UserActivityLog[]
  wordpressIntegrations   WordpressIntegration[]
  wordpressWebhookLogs    WordpressWebhookLog[]
  funnelObjectives        CampaignFunnelObjective[]
  funnelKeyResults        CampaignFunnelKeyResult[]

  @@map("organizations")
}

/// Associative join defining user role and membership within an organization
/// Source: Product Document p. 6 §1, p. 23 §27
model OrganizationMembership {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  userId              String           @db.Uuid
  role                Role             @default(campaign_manager)
  status              MembershipStatus @default(active)
  invitationTokenHash String?          @unique @db.VarChar(64)
  invitationExpiresAt DateTime?
  invitedAt           DateTime?
  joinedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

/// User authentication session and active organization context
/// Source: Product Document p. 6 §1; Implementation Decision
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String?   @db.Uuid
  isRevoked      Boolean   @default(false)
  revokedAt      DateTime?
  revokedReason  String?   @db.VarChar(255)
  userAgent      String?   @db.VarChar(500)
  ipAddress      String?   @db.VarChar(45)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@unique([id, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([isRevoked])
  @@map("sessions")
}

/// Cryptographic refresh token instances and rotation history
/// Source: docs/PROJECT-DECISIONS.md §4 DEC-AUTH-01; B2.3.2.3 & B2.3.2.4
model RefreshToken {
  id                String      @id @default(uuid()) @db.Uuid
  sessionId         String      @db.Uuid
  userId            String      @db.Uuid
  tokenHash         String      @unique @db.VarChar(64)
  status            TokenStatus @default(ACTIVE)
  replacedByTokenId String?     @unique @db.Uuid
  expiresAt         DateTime
  createdAt         DateTime    @default(now())
  consumedAt        DateTime?
  revokedAt         DateTime?

  session         Session        @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenReplacementChain", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  previousTokens  RefreshToken[] @relation("TokenReplacementChain")

  @@index([sessionId])
  @@index([userId, status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Dynamic tenant-configurable taxonomies for dropdowns and categories
/// Source: Product Document p. 23 §27, p. 24 §28
model OrganizationTaxonomy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  taxonomyType   String   @db.VarChar(100) // e.g. campaign_type, campaign_objective, lead_source, lost_reason
  key            String   @db.VarChar(100)
  label          String   @db.VarChar(255)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, taxonomyType, key])
  @@index([organizationId, taxonomyType])
  @@map("organization_taxonomies")
}

/// User notification preferences matrix per event type and delivery channel (Audit MAJ-03)
/// Source: Product Document p. 7 §3 (جدول نوع رویداد × کانال درون‌برنامه‌ای، ایمیل با سوئیچ)
model NotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  eventType      String   @db.VarChar(100) // e.g. lead_assigned, task_due, campaign_alert, cost_threshold
  inAppEnabled   Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, eventType])
  @@index([organizationId, userId])
  @@map("notification_preferences")
}

// ==============================================================================
// 2. PERFORMANCE & MARKETING DOMAIN (WORKSPACE 1)
// ==============================================================================

/// Core marketing campaign tracking budget, spend, status, and health
/// Source: Product Document p. 8 §4, p. 9 §6, p. 10 §7; docs/PROJECT-DECISIONS.md
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(255)
  description    String?        @db.Text
  type           String         @default("digital") @db.VarChar(100) // Configurable taxonomy
  objective      String         @default("lead") @db.VarChar(100) // Configurable taxonomy
  channel        String         @db.VarChar(100) // Legacy compatibility channel
  status         CampaignStatus @default(draft)
  health         CampaignHealth @default(healthy)
  budget         Decimal        @default(0) @db.Decimal(12, 2) // Monetary non-negative integer Toman/Rial
  spend          Decimal        @default(0) @db.Decimal(12, 2) // Aggregated expense in Toman/Rial
  startDate      DateTime?      @db.Date
  endDate        DateTime?      @db.Date
  ownerId        String?        @db.Uuid
  targetLeads    Int?
  targetSales    Decimal?       @db.Decimal(12, 2)
  impressions    Int            @default(0)
  clicks         Int            @default(0)
  conversions    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tenant and owner relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Sub-allocations and marketing assets (Compound Foreign Key Targets: CRIT-01)
  platformAllocations CampaignPlatformAllocation[]
  campaignAudiences   CampaignAudience[]
  landingPages        LandingPage[]
  utmLinks            UtmLink[]
  costs               Cost[]
  leads               Lead[]
  smsCampaigns        SmsCampaign[]
  webinars            Webinar[]
  eventEquipments     EventEquipment[]
  meetings            Meeting[]
  ideas               Idea[]
  kpiMetrics          KpiMetric[]
  funnelObjectives    CampaignFunnelObjective[]

  @@unique([id, organizationId]) // Enforces multi-tenant composite isolation (CRIT-01)
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, health])
  @@index([organizationId, ownerId])
  @@map("campaigns")
}

/// Advertising platform/channel master catalogue
/// Source: Product Document p. 8 §4, p. 11 §8
model Platform {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  name            String                  @db.VarChar(100)
  code            String                  @db.VarChar(50)
  category        String                  @db.VarChar(50) // digital, sms, social, ad_network
  retrievalMethod PlatformRetrievalMethod @default(manual) // دستی / API / Import (Audit MIN-01)
  icon            String?                 @db.VarChar(100)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allocations  CampaignPlatformAllocation[]
  costs        Cost[]
  leads        Lead[]
  utmLinks     UtmLink[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("platforms")
}

/// Budget and target volume sub-allocation per advertising platform (Audit CRIT-01)
/// Source: Product Document p. 9 §6 (Step 3), p. 10 §7
model CampaignPlatformAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  campaignId      String   @db.Uuid
  platformId      String   @db.Uuid
  allocatedBudget Decimal  @default(0) @db.Decimal(12, 2)
  targetCount     Int?
  actualSpend     Decimal  @default(0) @db.Decimal(12, 2)
  actualCount     Int      @default(0)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([campaignId, platformId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([platformId])
  @@map("campaign_platform_allocations")
}

/// Objective (O) for a specific sales funnel stage of a campaign
model CampaignFunnelObjective {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  campaignId     String   @db.Uuid
  stageKey       String   @db.VarChar(50)
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                  @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  keyResults   CampaignFunnelKeyResult[]

  @@unique([id, organizationId])
  @@unique([campaignId, stageKey, organizationId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([campaignId, stageKey])
  @@map("campaign_funnel_objectives")
}

/// Key Result (KR) measured under an Objective for a funnel stage
model CampaignFunnelKeyResult {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  objectiveId    String   @db.Uuid
  title          String   @db.VarChar(255)
  currentValue   Decimal  @default(0) @db.Decimal(12, 2)
  targetValue    Decimal  @default(100) @db.Decimal(12, 2)
  unit           String   @default("عدد") @db.VarChar(50)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objective    CampaignFunnelObjective @relation(fields: [objectiveId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tasks        Task[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([objectiveId])
  @@map("campaign_funnel_key_results")
}

/// Target audience demographic and psychographic profiles (Audit CRIT-02: Reusable M:N)
/// Source: Product Document p. 9 §6, p. 13 §11, p. 14 §11
model TargetAudience {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  ageMin         Int?
  ageMax         Int?
  gender         String?  @db.VarChar(20)
  interests      String?  @db.Text
  location       String?  @db.VarChar(255)
  channel        String?  @db.VarChar(100) // کانال مناسب (PRD p. 14)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    CampaignAudience[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@map("target_audiences")
}

/// Associative join table establishing Many-to-Many Campaign-Audience reuse (Audit CRIT-02)
/// Source: Product Document p. 9 §6 (Step 2) & p. 14 §11 (کمپین‌هایی که از این مخاطب استفاده کرده‌اند)
model CampaignAudience {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  campaignId       String   @db.Uuid
  targetAudienceId String   @db.Uuid
  createdAt        DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign       @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  targetAudience TargetAudience @relation(fields: [targetAudienceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([campaignId, targetAudienceId])
  @@index([organizationId])
  @@index([campaignId])
  @@index([targetAudienceId])
  @@map("campaign_audiences")
}

/// Destination marketing landing pages (Audit CRIT-01)
/// Source: Product Document p. 9 §6, p. 14 §12
model LandingPage {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  campaignId       String?  @db.Uuid
  title            String   @db.VarChar(255)
  url              String   @db.VarChar(500)
  slug             String?  @db.VarChar(200)
  template         String?  @db.VarChar(100)
  viewsCount       Int      @default(0)
  leadsCount       Int      @default(0)
  conversionRate   Decimal  @default(0) @db.Decimal(5, 2)
  connectionStatus Boolean  @default(true) // وضعیت اتصال (p. 14)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  utmLinks     UtmLink[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([campaignId])
  @@map("landing_pages")
}

/// Generated UTM campaign tracking links (Audit CRIT-01)
/// Source: Product Document p. 9 §6, p. 14 §13
model UtmLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  campaignId     String?  @db.Uuid
  landingPageId  String?  @db.Uuid
  platformId     String?  @db.Uuid
  originalUrl    String   @db.VarChar(1000)
  utmSource      String   @db.VarChar(100)
  utmMedium      String   @db.VarChar(100)
  utmCampaign    String   @db.VarChar(100)
  utmTerm        String?  @db.VarChar(100)
  utmContent     String?  @db.VarChar(100)
  finalUrl       String   @db.VarChar(1500)
  clicksCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  landingPage  LandingPage? @relation(fields: [landingPageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  platform     Platform?    @relation(fields: [platformId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@index([landingPageId])
  @@index([platformId])
  @@map("utm_links")
}

/// Configurable taxonomy category for marketing expenditures
/// Source: Product Document p. 23 §27, p. 24 §28
model CostCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  code           String   @db.VarChar(50)
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costs        Cost[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cost_categories")
}

/// Granular expense transaction record attributed to campaign, platform, and date (Audit CRIT-01)
/// Source: Product Document p. 8 §4, p. 11 §9, p. 12 §9; docs/PROJECT-DECISIONS.md
model Cost {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  campaignId     String?    @db.Uuid
  platformId     String?    @db.Uuid
  categoryId     String?    @db.Uuid
  date           DateTime   @db.Date
  amount         Decimal    @default(0) @db.Decimal(12, 2) // Non-negative integer Toman/Rial
  count          Int?
  source         CostSource @default(manual)
  createdById    String?    @db.Uuid
  importJobId    String?    @db.Uuid
  notes          String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Restrict)
  platform     Platform?     @relation(fields: [platformId, organizationId], references: [id, organizationId], onDelete: Cascade)
  category     CostCategory? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User?         @relation("CostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  importJob    ImportJob?    @relation(fields: [importJobId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([campaignId])
  @@index([platformId])
  @@index([categoryId])
  @@index([importJobId])
  @@map("costs")
}

