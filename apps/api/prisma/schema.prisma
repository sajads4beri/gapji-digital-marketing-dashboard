/// Organization-configurable lead status with open/won/lost grouping (Audit MAJ-02)
/// Source: Product Document p. 23 §28 (وضعیت‌های لید: ستون «گروه» باز/برنده/بازنده)
model LeadStatusConfig {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  key            String          @db.VarChar(100) // new, contacted, qualified, proposal, customer, lost
  label          String          @db.VarChar(255) // جدید، تماس‌گرفته، واجد شرایط، ارسال پروپوزال، مشتری، ردشده
  group          LeadStatusGroup @default(open) // باز، برنده، بازنده
  color          String?         @db.VarChar(50)
  sortOrder      Int             @default(0)
  isSystem       Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("lead_status_configs")
}

/// Customer sales opportunity and contact details (Audit CRIT-01, MAJ-02)
/// Source: Product Document p. 8 §4, p. 14 §14, p. 15 §14, p. 16 §15
model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  fullName         String    @db.VarChar(255)
  mobile           String    @db.VarChar(20)
  email            String?   @db.VarChar(255)
  city             String?   @db.VarChar(100)
  source           String    @default("manual") @db.VarChar(100)
  campaignId       String?   @db.Uuid
  platformId       String?   @db.Uuid
  utmSource        String?   @db.VarChar(100)
  utmMedium        String?   @db.VarChar(100)
  utmCampaign      String?   @db.VarChar(100)
  utmTerm          String?   @db.VarChar(100)
  utmContent       String?   @db.VarChar(100)
  statusKey        String    @default("new") @db.VarChar(100) // Configurable status (MAJ-02)
  statusConfigId   String?   @db.Uuid
  assignedToId     String?   @db.Uuid
  salesValue       Decimal?  @db.Decimal(12, 2) // Closed deal value in Toman/Rial
  lostReason       String?   @db.VarChar(255)
  nextFollowUpAt   DateTime?
  nextFollowUpNote String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?         @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Restrict)
  platform     Platform?         @relation(fields: [platformId, organizationId], references: [id, organizationId], onDelete: Cascade)
  statusConfig LeadStatusConfig? @relation(fields: [statusConfigId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedTo   User?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  activities        LeadActivity[]
  calls             LeadCall[]
  webinarAttendance WebinarAttendee[]
  convertedSmsLogs  SmsRecipient[]    @relation("SmsReplierLead")

  @@unique([id, organizationId]) // Enforces multi-tenant composite isolation (CRIT-01)
  @@index([organizationId])
  @@index([organizationId, statusKey])
  @@index([organizationId, assignedToId])
  @@index([organizationId, mobile])
  @@index([campaignId])
  @@map("leads")
}

/// Immutable event logging customer journey touchpoints and sales state transitions (Audit CRIT-01)
/// Source: Product Document p. 16 §16
model LeadActivity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  leadId         String           @db.Uuid
  type           LeadActivityType
  title          String           @db.VarChar(255)
  details        String?          @db.Text
  actorUserId    String?          @db.Uuid
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actorUser    User?        @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([leadId])
  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// Sales agent phone call log and outcome (Audit CRIT-01)
/// Source: Product Document p. 16 §17
model LeadCall {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  leadId          String         @db.Uuid
  callerUserId    String         @db.Uuid
  status          LeadCallStatus @default(successful)
  durationSeconds Int            @default(0)
  note            String?        @db.Text
  recordingUrl    String?        @db.VarChar(500)
  callDate        DateTime       @default(now())
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  callerUser   User         @relation("LeadCallCaller", fields: [callerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadId])
  @@index([callerUserId])
  @@map("lead_calls")
}

/// Outbound SMS delivery batch execution and delivery reporting (Audit CRIT-01)
/// Source: Product Document p. 10 §7, p. 16 §16, p. 17 §17
model SmsCampaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  campaignId     String?   @db.Uuid
  name           String    @db.VarChar(255)
  senderNumber   String    @db.VarChar(50)
  messageText    String    @db.Text
  recipientCount Int       @default(0)
  deliveredCount Int       @default(0)
  failedCount    Int       @default(0)
  costAmount     Decimal   @default(0) @db.Decimal(12, 2)
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         SmsStatus @default(draft)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?      @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  recipients   SmsRecipient[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([campaignId])
  @@map("sms_campaigns")
}

/// Individual SMS recipient delivery status and incoming replies (Audit MAJ-01, CRIT-01)
/// Source: Product Document p. 17 §17 (جدول شماره‌ها: شماره ماسک‌شده، وضعیت، زمان، پاسخ؛ ساخت لید از پاسخ‌دهندگان)
model SmsRecipient {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  smsCampaignId   String            @db.Uuid
  mobile          String            @db.VarChar(20)
  status          SmsDeliveryStatus @default(pending)
  deliveredAt     DateTime?
  replyText       String?           @db.Text
  repliedAt       DateTime?
  convertedLeadId String?           @db.Uuid
  createdAt       DateTime          @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  smsCampaign   SmsCampaign  @relation(fields: [smsCampaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  convertedLead Lead?        @relation("SmsReplierLead", fields: [convertedLeadId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([smsCampaignId])
  @@index([mobile])
  @@index([convertedLeadId])
  @@map("sms_recipients")
}

/// Educational or promotional online webinar event (Audit CRIT-01)
/// Source: Product Document p. 17 §18, p. 18 §18
model Webinar {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  campaignId      String?       @db.Uuid
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  presenterName   String        @db.VarChar(255)
  platform        String        @db.VarChar(100)
  webinarDate     DateTime
  durationMinutes Int           @default(60)
  registrationUrl String?       @db.VarChar(500)
  bannerUrl       String?       @db.VarChar(500)
  status          WebinarStatus @default(draft)
  capacity        Int?
  registeredCount Int           @default(0)
  attendedCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign        Campaign?         @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  attendees       WebinarAttendee[]
  eventEquipments EventEquipment[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([campaignId])
  @@map("webinars")
}

/// Registrant and attendance tracking for webinars (Audit CRIT-01)
/// Source: Product Document p. 17 §18, p. 18 §18
model WebinarAttendee {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  webinarId      String    @db.Uuid
  leadId         String?   @db.Uuid
  fullName       String    @db.VarChar(255)
  mobile         String    @db.VarChar(20)
  email          String?   @db.VarChar(255)
  attended       Boolean   @default(false)
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webinar      Webinar      @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([webinarId, mobile])
  @@index([organizationId])
  @@index([webinarId])
  @@index([leadId])
  @@map("webinar_attendees")
}

