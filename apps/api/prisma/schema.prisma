/// Operational task, action item, or SOP checklist assigned to team members (Audit CRIT-01)
/// Source: Product Document p. 8 §4, p. 18 §19, p. 19 §19
model Task {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  title          String           @db.VarChar(255)
  description    String?          @db.Text
  status         TaskStatus       @default(todo)
  priority       TaskPriority     @default(medium)
  dueDate        DateTime?        @db.Date
  assigneeId     String?          @db.Uuid
  createdById    String           @db.Uuid
  relatedType    TaskRelatedType?
  relatedId      String?          @db.Uuid
  sopId          String?          @db.Uuid // Explicit link to SOP (p. 18)
  okrKeyResultId String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?                    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User                     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sop          Sop?                     @relation("TaskSopSource", fields: [sopId, organizationId], references: [id, organizationId], onDelete: Cascade)
  okrKeyResult CampaignFunnelKeyResult? @relation(fields: [okrKeyResultId], references: [id], onDelete: SetNull)

  subtasks           TaskSubtask[]
  comments           TaskComment[]
  meetingActionItems MeetingActionItem[]
  generatedFromIdeas Idea[]              @relation("IdeaCreatedTask")

  @@unique([id, organizationId]) // Enforces multi-tenant composite isolation (CRIT-01)
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([relatedType, relatedId])
  @@index([sopId])
  @@index([okrKeyResultId])
  @@map("tasks")
}

/// Checklist subtask item within a parent task (Audit CRIT-01)
/// Source: Product Document p. 18 §19
model TaskSubtask {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  taskId         String   @db.Uuid
  title          String   @db.VarChar(255)
  isCompleted    Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId])
  @@map("task_subtasks")
}

/// Discussion comments and collaboration on tasks (Audit CRIT-01)
/// Source: Product Document p. 18 §19
model TaskComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  taskId         String   @db.Uuid
  authorUserId   String   @db.Uuid
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorUser   User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([taskId])
  @@map("task_comments")
}

/// Scheduled timeline event or multi-day campaign milestone
/// Source: Product Document p. 19 §20
model CalendarEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  organizationId  String                    @db.Uuid
  title           String                    @db.VarChar(255)
  description     String?                   @db.Text
  startDate       DateTime
  endDate         DateTime
  isAllDay        Boolean                   @default(false)
  startTime       String?                   @db.VarChar(10)
  endTime         String?                   @db.VarChar(10)
  color           String?                   @db.VarChar(50)
  eventType       String                    @default("meeting") @db.VarChar(50)
  relatedType     TaskRelatedType?
  relatedId       String?                   @db.Uuid
  createdById     String                    @db.Uuid
  assigneeId      String?                   @db.Uuid
  equipmentStatus EquipmentReadinessStatus?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("CalendarEventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, eventType])
  @@map("calendar_events")
}

