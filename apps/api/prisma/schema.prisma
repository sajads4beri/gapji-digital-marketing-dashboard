/// Target KPI metric definition and historical actual tracking (Audit CRIT-01, MAJ-04)
/// Source: Product Document p. 8 §4, p. 13 §11
model KpiMetric {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  campaignId     String?         @db.Uuid
  name           String          @db.VarChar(100)
  code           String          @db.VarChar(50)
  formula        String?         @db.Text // فرمول سفارشی ساز (Audit MAJ-04, p. 13)
  direction      MetricDirection @default(higher_is_better) // بالاتر/پایین‌تر بهتر (Audit MAJ-04, p. 13)
  targetValue    Decimal         @db.Decimal(12, 2)
  actualValue    Decimal         @default(0) @db.Decimal(12, 2)
  unit           String          @db.VarChar(50)
  period         String          @db.VarChar(50)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?      @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  alertRules   KpiAlertRule[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@index([campaignId])
  @@map("kpi_metrics")
}

/// Custom metric definitions for formula builder (Source: Product Document p. 13 §11)
model CustomMetric {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(100)
  code           String          @db.VarChar(50)
  description    String?         @db.Text
  formula        String          @db.Text
  direction      MetricDirection @default(higher_is_better)
  unit           String          @default("تومان") @db.VarChar(50)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("custom_metrics")
}

/// Alert trigger threshold for campaign KPI deviance (Audit CRIT-01, MAJ-04)
/// Source: Product Document p. 8 §4, p. 13 §11
model KpiAlertRule {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  kpiMetricId     String?  @db.Uuid
  metricName      String   @db.VarChar(100)
  condition       String   @db.VarChar(20) // gt, lt, eq, gte, lte
  thresholdValue  Decimal  @db.Decimal(12, 2)
  severity        String   @default("warning") @db.VarChar(50)
  message         String   @db.VarChar(500) // پیام هشدار (Audit MAJ-04, p. 13)
  suggestedAction String?  @db.VarChar(500) // اقدام پیشنهادی (Audit MAJ-04, p. 13)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kpiMetric    KpiMetric?   @relation(fields: [kpiMetricId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([kpiMetricId])
  @@map("kpi_alert_rules")
}

/// Batch file data import job execution history and reporting (Audit MIN-02)
/// Source: Product Document p. 12 §10, p. 13 §10
model ImportJob {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  dataType          ImportDataType
  fileName          String         @db.VarChar(255)
  fieldMapping      String?        @db.Text // نگاشت ذخیره‌شده ستون‌ها (Audit MIN-02, p. 12)
  duplicateHandling String?        @db.VarChar(50) // رفتار تکراری: نادیده بگیر / به‌روز کن (Audit MIN-02, p. 13)
  totalRows         Int            @default(0)
  successfulRows    Int            @default(0)
  failedRows        Int            @default(0)
  status            ImportStatus   @default(pending)
  createdById       String         @db.Uuid
  errorLog          String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ImportJobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  costs        Cost[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (MAJ-A)
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("import_jobs")
}

/// In-app notifications and system alerts for users
/// Source: Product Document p. 7 §3
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @db.Uuid
  userId         String           @db.Uuid
  title          String           @db.VarChar(255)
  message        String           @db.Text
  type           NotificationType @default(info)
  isRead         Boolean          @default(false)
  linkUrl        String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

/// Immutable system security and user activity audit trail
/// Source: Product Document p. 22 §26, p. 23 §26
model UserActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String   @db.VarChar(100)
  entityType     String   @db.VarChar(100)
  entityId       String?  @db.Uuid
  details        String?  @db.Text
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("user_activity_logs")
}

/// WordPress integration configuration and lead webhook mapping (Audit CRIT-01)
/// Source: Product Document p. 24 §29
model WordpressIntegration {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  siteUrl           String    @db.VarChar(500)
  apiKeyHash        String    @db.VarChar(255)
  webhookSecret     String    @db.VarChar(255)
  leadMappingConfig String    @db.Text // JSON mapping configuration
  isActive          Boolean   @default(true)
  lastSyncAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookLogs  WordpressWebhookLog[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@unique([organizationId, siteUrl])
  @@index([organizationId])
  @@map("wordpress_integrations")
}

/// WordPress webhook incoming request and failure log (Audit MIN-03, CRIT-01)
/// Source: Product Document p. 24 §29 (لاگ درخواست‌های ردشده: زمان، علت)
model WordpressWebhookLog {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  wordpressIntegrationId String   @db.Uuid
  status                 String   @db.VarChar(50) // success, rejected, error
  reason                 String?  @db.Text // علت رد شدن
  payloadSummary         String?  @db.Text // خلاصه لاگ بدون اطلاعات حساس
  ipAddress              String?  @db.VarChar(45)
  receivedAt             DateTime @default(now())

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wordpressIntegration WordpressIntegration @relation(fields: [wordpressIntegrationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([wordpressIntegrationId])
  @@index([receivedAt])
  @@map("wordpress_webhook_logs")
}
