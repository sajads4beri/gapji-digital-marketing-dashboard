// 5. EQUIPMENT & EVENT READINESS DOMAIN (WORKSPACE 3 - Audit CRIT-03)
// ==============================================================================

/// Reusable equipment catalog item (Audit CRIT-03)
/// Source: Product Document p. 19 §21
model EquipmentItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(255) // نام تجهیز: میکروفون یقه ای، وبکم 4K، رینگ لایت...
  category       String   @db.VarChar(100) // صوت، تصویر، نور، استریم
  description    String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventInstances EventEquipment[]
  templateItems  EquipmentTemplateItem[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@map("equipment_items")
}

/// Predefined equipment checklists/templates applied to events (Audit CRIT-03)
/// Source: Product Document p. 19 §21 (قالب‌های تجهیزات — لیست آماده، اعمال قالب روی کمپین/وبینار)
model EquipmentTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(255) // e.g. قالب تجهیزات وبینار، قالب ضبط استودیویی
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        EquipmentTemplateItem[]

  @@unique([id, organizationId]) // Compound Foreign Key Target (CRIT-01)
  @@index([organizationId])
  @@map("equipment_templates")
}

/// Items contained within a predefined equipment template (Audit CRIT-03, CRIT-01)
/// Source: Product Document p. 19 §21
model EquipmentTemplateItem {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @db.Uuid
  templateId      String @db.Uuid
  equipmentItemId String @db.Uuid
  quantity        Int    @default(1)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template      EquipmentTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  equipmentItem EquipmentItem     @relation(fields: [equipmentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([templateId, equipmentItemId])
  @@index([organizationId])
  @@map("equipment_template_items")
}

/// Operational gear readiness instance tied to a campaign or webinar (Audit CRIT-03, CRIT-01)
/// Source: Product Document p. 10 §7, p. 17 §18, p. 19 §21 (کمبودها بر اساس تاریخ اجرا، مسئول تهیه، مهلت، آماده/ناقص/تهیه نشده)
model EventEquipment {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  equipmentItemId String                   @db.Uuid
  campaignId      String?                  @db.Uuid
  webinarId       String?                  @db.Uuid
  status          EquipmentReadinessStatus @default(not_procured) // آماده · ناقص · تهیه نشده (p. 5)
  responsibleId   String?                  @db.Uuid // مسئول تهیه (p. 19)
  dueDate         DateTime?                @db.Date // مهلت تهیه (p. 19)
  notes           String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipmentItem EquipmentItem @relation(fields: [equipmentItemId, organizationId], references: [id, organizationId], onDelete: Cascade)
  campaign      Campaign?     @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Cascade)
  webinar       Webinar?      @relation(fields: [webinarId, organizationId], references: [id, organizationId], onDelete: Cascade)
  responsible   User?         @relation("EquipmentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([webinarId])
  @@index([dueDate])
  @@map("event_equipments")
}

