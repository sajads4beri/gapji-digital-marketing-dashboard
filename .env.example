# ============ Root / Shared ============
NODE_ENV=development
PORT_API=3001
PORT_WEB=3000
API_URL=http://localhost:3001

# ============ PostgreSQL ============
POSTGRES_USER=gapji_user
POSTGRES_PASSWORD=gapji_password
POSTGRES_DB=gapji_dashboard
