DATABASE_URL=postgresql://gapji_user:gapji_password@localhost:5432/gapji_dashboard?schema=public

# ============ NestJS ============
API_PORT=3001
API_PREFIX=api
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ============ Next.js ============
NEXT_PUBLIC_API_URL=http://localhost:3001/api
