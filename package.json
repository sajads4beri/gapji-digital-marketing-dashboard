{
  "name": "gapji-digital-marketing-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo digital marketing dashboard with NestJS, Next.js and PostgreSQL",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "pnpm run dev --workspace=apps/api",
    "dev:web": "pnpm run dev --workspace=apps/web",
    "dev": "concurrently \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "build:api": "pnpm run build --workspace=apps/api",
    "build:web": "pnpm run build --workspace=apps/web",
    "build": "pnpm run build:api && pnpm run build:web",
    "start:api": "pnpm run start:prod --workspace=apps/api",
    "start:web": "pnpm run start --workspace=apps/web",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:studio": "pnpm exec prisma studio --workspace=apps/api 2>/dev/null || echo 'Prisma not configured, using raw TypeORM'"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
