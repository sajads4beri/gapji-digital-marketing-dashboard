{
  "name": "gapji-digital-marketing-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo digital marketing dashboard with NestJS, Next.js and PostgreSQL",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @gapji/api dev",
    "dev:web": "pnpm --filter @gapji/web dev",
    "dev": "concurrently \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "build:shared": "pnpm --filter @gapji/shared build",
    "build:api": "pnpm --filter @gapji/api build",
    "build:web": "pnpm --filter @gapji/web build",
    "build": "pnpm --filter @gapji/shared build && pnpm --filter @gapji/api build && pnpm --filter @gapji/web build",
    "start:api": "pnpm --filter @gapji/api start:prod",
    "start:web": "pnpm --filter @gapji/web start",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:studio": "pnpm --filter @gapji/api prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0"
  }
}
